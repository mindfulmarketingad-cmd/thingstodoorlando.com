# Copy to .env.local for local development and add the same keys in your host (e.g. Vercel project settings).

# Required: Viator Partner API key (server-side only, never exposed to the browser)
VIATOR_API_KEY=

# Optional
# VIATOR_API_BASE=https://api.viator.com/partner
# VIATOR_DESTINATION_ID=663
# Affiliate IDs appended to Viator search links on expert guide pages
# VIATOR_PID=
# VIATOR_MCID=

NEXT_PUBLIC_SITE_URL=https://thingstodoorlando.com

# Social profile URLs (footer icons + Organization schema)
# NEXT_PUBLIC_INSTAGRAM_URL=
# NEXT_PUBLIC_TWITTER_URL=
# NEXT_PUBLIC_FACEBOOK_URL=

# Contact form delivery: Resend (recommended) or a generic HTTPS webhook
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=
# CONTACT_FROM_EMAIL=ThingsToDoOrlando.com <contact@thingstodoorlando.com>
# CONTACT_WEBHOOK_URL=
